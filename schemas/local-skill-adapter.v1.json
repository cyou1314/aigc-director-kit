{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aigc-director-kit:local-skill-adapter:v1",
  "title": "AIGC Director Local Skill Adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "adapter_id",
    "visibility",
    "source_access",
    "workflow_contract",
    "stages"
  ],
  "properties": {
    "contract": {"const": "aigc-director-local-skill-adapter"},
    "version": {"const": 1},
    "adapter_id": {"$ref": "#/$defs/label"},
    "visibility": {"const": "public-metadata-only"},
    "source_access": {"const": "local-only"},
    "workflow_contract": {"const": "aigc-director-skill-workflow"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skill_label",
        "role",
        "input_contracts",
        "output_contract",
        "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/label"},
        "skill_label": {"$ref": "#/$defs/label"},
        "role": {"type": "string", "minLength": 1, "maxLength": 240},
        "input_contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/label"}
        },
        "output_contract": {"$ref": "#/$defs/label"},
        "evidence": {"enum": ["observed", "inferred", "designed"]}
      }
    }
  }
}
