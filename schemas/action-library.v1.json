{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aigc-director-kit:action-library:v1",
  "title": "AIGC Director Action Library v1",
  "type": "object",
  "required": ["contract", "version", "actions"],
  "properties": {
    "contract": {"const": "aigc-director-action-library"},
    "version": {"const": 1},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id", "display_name", "duration_s"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "category": {"type": "string"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "source_type": {"type": "string"},
        "root_motion": {"type": "boolean"}
      }
    }
  }
}
